# Copy to .env and fill in. NEVER commit the real .env — it is git-ignored.
# On shared hosting, set these in the control panel instead of a file.

SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@spyrja.com
SMTP_PASS=

# Envelope sender — must be on a domain you control, so SPF/DKIM stay aligned.
MAIL_FROM=no-reply@spyrja.com

# Where enquiries are delivered.
MAIL_TO=samband@spyrja.com
